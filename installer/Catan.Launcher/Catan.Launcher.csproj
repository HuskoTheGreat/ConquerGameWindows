<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Catan.Launcher</RootNamespace>
    <AssemblyName>CatanLauncher</AssemblyName>
    <ApplicationIcon>..\catan.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Folder the launcher downloads latest.json and the game zip from. CI overrides it with -p:UpdateUrl=... -->
    <UpdateUrl Condition="'$(UpdateUrl)' == ''">https://github.com/HuskoTheGreat/ConquerGameWindows/releases/download/game-latest/</UpdateUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
    <InternalsVisibleTo Include="Catan.Launcher.Tests" />
  </ItemGroup>

</Project>
