[Unit]
Description=Conquer game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conquer
Group=conquer
WorkingDirectory=/opt/conquer/server
ExecStart=/usr/bin/dotnet /opt/conquer/server/Conquer.Server.dll
Restart=on-failure
RestartSec=3

# Small-VM runtime settings: cap the managed heap at 256 MB, no diagnostics pipes.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_GCHeapHardLimit=0x10000000
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
MemoryMax=400M
TasksMax=128
LimitNOFILE=4096

# Hardening: no privileges, read-only system, nothing but network sockets.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
