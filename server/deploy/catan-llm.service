[Unit]
Description=Local LLM for Catan commentary bots (llama.cpp server)
After=network-online.target

[Service]
Type=simple
User=catan-llm
Group=catan-llm
# Loopback only: the model is never reachable from the internet. One slot, two threads, small context.
ExecStart=/opt/catan/llama.cpp/build/bin/llama-server \
    --model /opt/catan/models/model.gguf \
    --host 127.0.0.1 --port 8081 \
    --ctx-size 2048 --parallel 1 --threads 2 \
    --no-webui
Restart=on-failure
RestartSec=5

# The game always wins: the model runs at low priority and can't take the whole machine.
Nice=15
CPUWeight=20
CPUQuota=200%
MemoryMax=2G

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
