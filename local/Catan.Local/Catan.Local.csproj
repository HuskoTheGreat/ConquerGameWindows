<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Catan.Local</RootNamespace>
    <AssemblyName>CatanLocal</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Catan.Client is an app too; this launcher's Main is the one that runs. -->
    <StartupObject>Catan.Local.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
  </ItemGroup>

  <!-- The same rules engine and the same window as the main client; nothing here talks to a server. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Catan.Core\Catan.Core.csproj" />
    <ProjectReference Include="..\..\src\Catan.Client\Catan.Client.csproj" />
  </ItemGroup>

</Project>
